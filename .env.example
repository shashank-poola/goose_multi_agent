# OpenRouter
OPENROUTER_API_KEY=

# Exa
EXA_API_KEY=

# Qdrant (cloud)
QDRANT_API_KEY=
QDRANT_CLUSTER_ID=

# SQLite (file path, relative to working dir)
DATABASE_URL=sqlite+aiosqlite:///./goose.db

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6379

# NextAuth — must match NEXTAUTH_SECRET in frontend .env
NEXTAUTH_SECRET=
